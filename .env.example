# ─── PRISM Configuration ────────────────────────────────────────────
# Copy this file to `.env` and fill in your keys.

# Claude (Anthropic) — required for default strategy
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# OpenClaw (or any OpenAI‑compatible endpoint: OpenAI, Groq, Ollama, LM Studio…)
OPENCLAW_API_KEY=
OPENCLAW_MODEL=gpt-4o-mini
OPENCLAW_BASE_URL=https://api.openai.com/v1

# Claude Mythos — fill in on release day
MYTHOS_API_KEY=
MYTHOS_MODEL=claude-mythos-1
MYTHOS_BASE_URL=https://api.anthropic.com/v1

# Routing
DEFAULT_STRATEGY=draft-polish
# Options: draft-polish | parallel-specialist | cascade | vote-of-three | context-share

# Server
PRISM_HOST=127.0.0.1
PRISM_PORT=7369
