# ─── PRISM Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in only the providers you intend to use.

# Claude (Anthropic)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# OpenClaw seat — may point at any OpenAI-compatible endpoint.
# For LM Studio/Ollama-compatible local servers, set the local base URL/model.
OPENCLAW_API_KEY=
OPENCLAW_MODEL=gpt-4o-mini
OPENCLAW_BASE_URL=https://api.openai.com/v1

# Optional third Anthropic-wire-compatible seat.
# PRISM will NOT silently fall back to Claude when this is blank.
MYTHOS_API_KEY=
MYTHOS_MODEL=
MYTHOS_BASE_URL=https://api.anthropic.com/v1

# Routing
DEFAULT_STRATEGY=cascade
# Options:
# draft-polish | parallel-specialist | cascade | vote-of-three |
# context-share | war-room

# Server
PRISM_HOST=127.0.0.1
PRISM_PORT=7369
